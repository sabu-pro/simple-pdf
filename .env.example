# Browser edit/merge/sign limit, per file. Rebuild after changing NEXT_PUBLIC values.
NEXT_TELEMETRY_DISABLED=1
NEXT_PUBLIC_MAX_UPLOAD_MB=50
# Conversion request limit, also enforced while streaming the request.
MAX_UPLOAD_MB=50
CONVERSION_TIMEOUT_MS=90000
MAX_PDF_PAGES=300
# Optional absolute path, e.g. C:\Program Files\LibreOffice\program\soffice.exe
LIBREOFFICE_PATH=
# Optional private temporary directory; defaults to the OS temp directory.
TEMP_DIRECTORY=
