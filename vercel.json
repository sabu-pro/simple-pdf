{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [{ "source": "/api/edit-text", "destination": "/api/edit-text-worker" }],
  "functions": {
    "api/**/*.py": {
      "maxDuration": 180,
      "excludeFiles": "{node_modules/**,.next/**,.git/**,.local/**,public/**,tests/**,docs/**}"
    }
  }
}
